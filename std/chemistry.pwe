  # Electrons that fit in shell n (Bohr): 2n^2.
  shell_capacity(n) { 2.0 * n * n }
  # Main-group valence electrons (H/He -> 1/2; else group for groups 1,2,13-18).
  valence_electrons(z) { if(z < 2.5, z, if(z < 11.5, z - 2.0, if(z < 19.5, z - 10.0, if(z < 37.5, z - 18.0, if(z < 55.5, z - 36.0, z - 54.0))))) }
  neutrons(z, mass) { round(mass) - z }
  mol_from_mass(mass, molar_mass) { mass / molar_mass }
  mass_from_mol(mol, molar_mass) { mol * molar_mass }
  molecules(mol) { mol * avogadro }
  molarity(mol, volume) { mol / volume }
  dilute(c1, v1, v2) { c1 * v1 / v2 }
  ideal_pressure(mol, temp, volume) { mol * R_gas * temp / volume }
  ideal_volume(mol, temp, pressure) { mol * R_gas * temp / pressure }
  arrhenius(pre_exponential, ea, temp) { pre_exponential * exp(0.0 - ea / (R_gas * temp)) }
  rate_constant(temp, ea) { exp(0.0 - ea / (R_gas * temp)) }
  activation_ratio(temp1, temp2, ea) { exp((0.0 - ea / R_gas) * (1.0 / temp2 - 1.0 / temp1)) }
  ph(h_concentration) { 0.0 - log10(h_concentration) }
  h_from_ph(ph_value) { pow(10.0, 0.0 - ph_value) }
  neutralization_volume(c1, v1, c2) { c1 * v1 / c2 }
  half_life_decay(lambda) { 0.6931471805599453 / lambda }
  radioactive_amount(n0, lambda, t) { n0 * exp(0.0 - lambda * t) }
}
