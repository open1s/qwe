# std/molecules/hydrogen_chloride.pwe — hydrogen chloride (generated).
# Atoms + `bond` lines (ball-and-stick). Import to render and to use
# `hydrogen_chloride.molar_mass()` / `hydrogen_chloride.atom_count()`.
module molecules.hydrogen_chloride
import "../elements/Cl"
import "../elements/H"
world {
  gravity = (0, 0, 0)
  entity Cl1 { position = (0, 0, 0); shape = sphere; size = 0.6; color = 0x1FF01F }
  entity H1 { position = (1.27, 0, 0); shape = sphere; size = 0.3; color = 0xFFFFFF }
  bond Cl1 H1
}

funcs {
  atom_count() { 2.0 }
  molar_mass() { Cl.atomic_mass() + H.atomic_mass() }
}
