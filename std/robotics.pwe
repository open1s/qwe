# std/robotics — kinematics and control.
import "math"

world { }

funcs {
  planar2_x(l1, l2, q1, q2) { l1 * cos(q1) + l2 * cos(q1 + q2) }
  planar2_y(l1, l2, q1, q2) { l1 * sin(q1) + l2 * sin(q1 + q2) }
  planar2_ik_q2(l1, l2, x, y) { acos((x * x + y * y - l1 * l1 - l2 * l2) / (2.0 * l1 * l2)) }
  planar2_ik_q1(l1, l2, x, y, q2) { atan2(y, x) - atan2(l2 * sin(q2), l1 + l2 * cos(q2)) }
  pid(kp, ki, kd, err, integ, deriv) { kp * err + ki * integ + kd * deriv }
  joint_accel(torque, inertia, damping, vel) { (torque - damping * vel) / inertia }
  diff_drive_v_left(v, omega, base) { v - omega * base * 0.5 }
  diff_drive_v_right(v, omega, base) { v + omega * base * 0.5 }
  trapezoid_peak(v_max, a, distance) { min(v_max, sqrt(a * distance)) }
  reach(x0, y0, x1, y1) { math.hypot2(x1 - x0, y1 - y0) }
  rotate_x(x, y, theta) { x * cos(theta) - y * sin(theta) }
  rotate_y(x, y, theta) { x * sin(theta) + y * cos(theta) }
}
