    let tb = sr + 0.9 + 0.4
    let jx = wx + (0.09 + 0.06) * sin(sr)
    let jy = wy - (0.09 + 0.06) * cos(sr)
    x = (wx + (0.09 + 0.5 * 0.06) * sin(sr) + 0.01 - x) + 0.0
    y = (wy - (0.09 + 0.5 * 0.06) * cos(sr) - y) + 0.0
    z = (0.0 - 0.19 + 0.065 - z) + 0.0
    ang = (ta - ang) + 0.0
  }
  update { on = thumbRb; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    let ss = 0.0 - 0.5 * sin(ph + 3.141592653589793)
    let sa = ss + 0.35
    let sr = ss + 0.35 + 0.1
    let wx = bodyX + 0.4 * sin(ss) + 0.34 * sin(sa)
    let wy = hy + 0.54 - 0.4 * cos(ss) - 0.34 * cos(sa)
    let ta = sr + 0.9
    let tb = sr + 0.9 + 0.4
    let jx = wx + (0.09 + 0.06) * sin(sr)
    let jy = wy - (0.09 + 0.06) * cos(sr)
    x = (jx + 0.5 * 0.05 * sin(tb) - x) + 0.0
    y = (jy - 0.5 * 0.05 * cos(tb) - y) + 0.0
    z = (0.0 - 0.19 + 0.075 - z) + 0.0
    ang = (tb - ang) + 0.0
  }
  update { on = hipR; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    let hh = 0.5 * sin(ph + 3.141592653589793)
    let kk = hh + 0.7 * max(0.0, 0.0 - sin(ph + 3.141592653589793 + 0.7))
    let kx = bodyX + 0.5 * sin(hh)
    let ky = hy - 0.5 * cos(hh)
    let ax = bodyX + 0.5 * sin(hh) + 0.5 * sin(kk)
    let ay = hy - 0.5 * cos(hh) - 0.5 * cos(kk)
    x = (bodyX - x) + 0.0
    y = (hy - y) + 0.0
    z = (0.0 - 0.11 - z) + 0.0
    ang = (0.0 - ang) + 0.0
  }
  update { on = thighR; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    let hh = 0.5 * sin(ph + 3.141592653589793)
    let kk = hh + 0.7 * max(0.0, 0.0 - sin(ph + 3.141592653589793 + 0.7))
    let kx = bodyX + 0.5 * sin(hh)
    let ky = hy - 0.5 * cos(hh)
    let ax = bodyX + 0.5 * sin(hh) + 0.5 * sin(kk)
    let ay = hy - 0.5 * cos(hh) - 0.5 * cos(kk)
    x = (bodyX + 0.5 * 0.5 * sin(hh) - x) + 0.0
    y = (hy - 0.5 * 0.5 * cos(hh) - y) + 0.0
    z = (0.0 - 0.11 - z) + 0.0
    ang = (hh - ang) + 0.0
  }
  update { on = kneeR; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    let hh = 0.5 * sin(ph + 3.141592653589793)
    let kk = hh + 0.7 * max(0.0, 0.0 - sin(ph + 3.141592653589793 + 0.7))
    let kx = bodyX + 0.5 * sin(hh)
    let ky = hy - 0.5 * cos(hh)
    let ax = bodyX + 0.5 * sin(hh) + 0.5 * sin(kk)
    let ay = hy - 0.5 * cos(hh) - 0.5 * cos(kk)
    x = (kx - x) + 0.0
    y = (ky - y) + 0.0
    z = (0.0 - 0.11 - z) + 0.0
    ang = (0.0 - ang) + 0.0
  }
  update { on = shinR; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    let hh = 0.5 * sin(ph + 3.141592653589793)
    let kk = hh + 0.7 * max(0.0, 0.0 - sin(ph + 3.141592653589793 + 0.7))
    let kx = bodyX + 0.5 * sin(hh)
    let ky = hy - 0.5 * cos(hh)
    let ax = bodyX + 0.5 * sin(hh) + 0.5 * sin(kk)
    let ay = hy - 0.5 * cos(hh) - 0.5 * cos(kk)
    x = (kx + 0.5 * 0.5 * sin(kk) - x) + 0.0
    y = (ky - 0.5 * 0.5 * cos(kk) - y) + 0.0
    z = (0.0 - 0.11 - z) + 0.0
    ang = (kk - ang) + 0.0
  }
  update { on = footR; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    let hh = 0.5 * sin(ph + 3.141592653589793)
    let kk = hh + 0.7 * max(0.0, 0.0 - sin(ph + 3.141592653589793 + 0.7))
    let kx = bodyX + 0.5 * sin(hh)
    let ky = hy - 0.5 * cos(hh)
    let ax = bodyX + 0.5 * sin(hh) + 0.5 * sin(kk)
    let ay = hy - 0.5 * cos(hh) - 0.5 * cos(kk)
    x = (ax + 0.07 - x) + 0.0
    y = (ay - 0.03 - y) + 0.0
    z = (0.0 - 0.11 - z) + 0.0
    ang = (0.0 - ang) + 0.0
  }
  update { on = toeR; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    let hh = 0.5 * sin(ph + 3.141592653589793)
    let kk = hh + 0.7 * max(0.0, 0.0 - sin(ph + 3.141592653589793 + 0.7))
    let kx = bodyX + 0.5 * sin(hh)
    let ky = hy - 0.5 * cos(hh)
    let ax = bodyX + 0.5 * sin(hh) + 0.5 * sin(kk)
    let ay = hy - 0.5 * cos(hh) - 0.5 * cos(kk)
    x = (ax + 0.23 - x) + 0.0
    y = (ay - 0.035 - y) + 0.0
    z = (0.0 - 0.11 - z) + 0.0
    ang = (0.0 - ang) + 0.0
  }
}
