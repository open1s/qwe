systems {
  update { on = pelvis; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = (bodyX - x) + 0.0
    y = (hy - y) + 0.0
    z = (0.0 - z) + 0.0
    ang = (0.0 - ang) + 0.0
  }
  update { on = torso; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    let lean = 0.05
    x = (bodyX - x) + 0.0
    y = (hy+0.3 - y) + 0.0
    z = (0.0 - z) + 0.0
    ang = (lean - ang) + 0.0
  }
  update { on = head; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = (bodyX + 0.03 - x) + 0.0
    y = (hy + 0.6 + 0.16 - y) + 0.0
    z = (0.0 - z) + 0.0
    ang = (0.0 - ang) + 0.0
  }
  update { on = neck; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = (bodyX + 0.02 - x) + 0.0
    y = (hy + 0.6 + 0.02 - y) + 0.0
    z = (0.0 - z) + 0.0
    ang = (0.0 - ang) + 0.0
  }
  update { on = eyeL; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = (bodyX + 0.03 + 0.135 - x) + 0.0
    y = (hy + 0.6 + 0.16 + 0.03 - y) + 0.0
    z = (0.055 - z) + 0.0
    ang = (0.0 - ang) + 0.0
  }
  update { on = browL; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = (bodyX + 0.03 + 0.145 - x) + 0.0
    y = (hy + 0.6 + 0.16 + 0.078 - y) + 0.0
    z = (0.055 - z) + 0.0
    ang = (0.0 - ang) + 0.0
  }
  update { on = eyeR; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = (bodyX + 0.03 + 0.135 - x) + 0.0
    y = (hy + 0.6 + 0.16 + 0.03 - y) + 0.0
    z = (-0.055 - z) + 0.0
    ang = (0.0 - ang) + 0.0
  }
  update { on = browR; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = (bodyX + 0.03 + 0.145 - x) + 0.0
    y = (hy + 0.6 + 0.16 + 0.078 - y) + 0.0
    z = (-0.055 - z) + 0.0
    ang = (0.0 - ang) + 0.0
  }
  update { on = nose; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = (bodyX + 0.03 + 0.165 - x) + 0.0
    y = (hy + 0.6 + 0.16 - 0.01 - y) + 0.0
    z = (0.0 - z) + 0.0
    ang = (0.0 - ang) + 0.0
  }
  update { on = mouth; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = (bodyX + 0.03 + 0.150 - x) + 0.0
    y = (hy + 0.6 + 0.16 - 0.058 - y) + 0.0
