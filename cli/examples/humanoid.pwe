systems {
  update { on = pelvis; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = bodyX
    y = hy
    z = 0.0
    ang = 0.0
  }
  update { on = torso; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    let lean = 0.05
    x = bodyX
    y = hy+0.29
    z = 0.0
    ang = lean
  }
  update { on = head; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = bodyX + 0.03
    y = hy + 0.58 + 0.16
    z = 0.0
    ang = 0.0
  }
  update { on = neck; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = bodyX + 0.02
    y = hy + 0.58 - 0.02
    z = 0.0
    ang = 0.0
  }
  update { on = eyeL; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = bodyX + 0.03 + 0.130
    y = hy + 0.58 + 0.16 + 0.03
    z = 0.058
    ang = 0.0
  }
  update { on = browL; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = bodyX + 0.03 + 0.142
    y = hy + 0.58 + 0.16 + 0.078
    z = 0.058
    ang = 0.0
  }
  update { on = eyeR; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = bodyX + 0.03 + 0.130
    y = hy + 0.58 + 0.16 + 0.03
    z = -0.058
    ang = 0.0
  }
  update { on = browR; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = bodyX + 0.03 + 0.142
    y = hy + 0.58 + 0.16 + 0.078
    z = -0.058
    ang = 0.0
  }
  update { on = nose; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = bodyX + 0.03 + 0.160
    y = hy + 0.58 + 0.16 - 0.010
    z = 0.0
    ang = 0.0
  }
  update { on = mouth; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    x = bodyX + 0.03 + 0.148
    y = hy + 0.58 + 0.16 - 0.058
    z = 0.0
    ang = 0.0
  }
  update { on = shoulderL; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    let ss = 0.0 - 0.5 * sin(ph)
    let sa = ss + 0.35
    let sr = ss + 0.35 + 0.1
    let sy = hy + 0.52
    let ex = bodyX + 0.4 * sin(ss)
    let ey = hy + 0.52 - 0.4 * cos(ss)
    let wx = bodyX + 0.4 * sin(ss) + 0.34 * sin(sa)
    let wy = hy + 0.52 - 0.4 * cos(ss) - 0.34 * cos(sa)
    let px = wx + 0.09 * sin(sr)
