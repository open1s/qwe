    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    let hh = 0.5 * sin(ph + 3.141592653589793)
    let kk = hh + 0.7 * max(0.0, 0.0 - sin(ph + 3.141592653589793 + 0.7))
    let kx = bodyX + 0.5 * sin(hh)
    let ky = hy - 0.5 * cos(hh)
    let ax = bodyX + 0.5 * sin(hh) + 0.5 * sin(kk)
    let ay = hy - 0.5 * cos(hh) - 0.5 * cos(kk)
    x = ax + 0.07
    y = ay - 0.03
    z = 0.0 - 0.11
    ang = 0.0
  }
  update { on = toeR; dt = 1.0
    let ph = 6.283185307179586 * t / 30.0
    let bodyX = 1.6 * sin(6.283185307179586 * t / 90.0)
    let bob = 0.035 * cos(2.0 * ph)
    let hy = 1.05 + bob
    let hh = 0.5 * sin(ph + 3.141592653589793)
    let kk = hh + 0.7 * max(0.0, 0.0 - sin(ph + 3.141592653589793 + 0.7))
    let kx = bodyX + 0.5 * sin(hh)
    let ky = hy - 0.5 * cos(hh)
    let ax = bodyX + 0.5 * sin(hh) + 0.5 * sin(kk)
    let ay = hy - 0.5 * cos(hh) - 0.5 * cos(kk)
    x = ax + 0.235
    y = ay - 0.03
    z = 0.0 - 0.11
    ang = 1.5707963267948966
  }
}
