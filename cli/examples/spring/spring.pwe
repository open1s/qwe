# spring.pwe — one program assembled from modules. `import` follows Python:
# a module's members are namespaced (imported `law`/`parts` contribute world
# content and systems), the `[unit]` annotations are dimensionally checked,
# `params` are runtime-settable, and `at`/`periodic` schedule events.
#
#   cargo build --release -p pwe-cli
#   pwe compile cli/examples/spring/spring.pwe -o spring.pweb
#   pwe run     spring.pweb --steps 400
#   pwe run     spring.pweb --steps 400 --param k=16.0     # stiffer spring
#   pwe present spring.pweb --port 8000

world {
  title = "damped oscillator (modules + params + units + scheduled events)"
  gravity = (0, 0, 0)

  params {
    k = 4.0 [1/s^2]
    damping = 0.3 [1/s]
  }

  import "parts"
}

systems {
  import "law"
}
