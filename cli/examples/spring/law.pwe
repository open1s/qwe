# law.pwe — a module contributing behaviour (systems). Its rules read the
# parameters declared by the importing program (bare `k`, `damping`).
world { }

systems {
  update { on = osc; dt = 0.02 [s]
    vx = 0.0 - k * x - damping * vx
    x = vx
    beat = if(periodic(1.0), 1.0, 0.0)
    kick = if(at(5.0), 1.0, 0.0)
  }
}
