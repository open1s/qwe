# Layer C — the "作用" between atoms: plot a chemical-bond potential
# (Morse). The 1D field U carries the curve U(r); `probe` sits at the
# equilibrium separation re. Import `std/micro` for the laws.
import "../../std/micro"

world {
  gravity = (0, 0, 0)
  field u { width = 64; height = 1; dx = 0.05 }
  entity probe { state = (r = 1.2) }
}

systems {
  update {
    on = probe
    dt = 0.05
    let _ = fset(u, 0, 0, micro.morse_potential(1.0, 2.0, 1.2, 0.7))
    let _ = fset(u, 1, 0, micro.morse_potential(1.0, 2.0, 1.2, 0.74))
    let _ = fset(u, 2, 0, micro.morse_potential(1.0, 2.0, 1.2, 0.78))
