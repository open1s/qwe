# wave3d.pwe — a point source radiates spherical wavefronts through 3D space.
#
# Space is 3D (a width×height×depth lattice); time is the 4th dimension. A
# smooth Gaussian pulse is re-emitted at the centre periodically and a graded
# sponge layer (`absorb`) soaks the waves up at the boundary instead of
# reflecting — so each wavefront travels outward and fades. The viewer draws
# the field as two nested isosurfaces (a warm crest and a cool trough) whose
# colour also falls off with radius, so the energy decay is visible.
world {
  gravity = (0, 0, 0)
  field u  { width = 17; height = 17; depth = 17; dx = 1.0 }
  field um { width = 17; height = 17; depth = 17; dx = 1.0 }
  entity probe { state = (x = 0.0, y = 0.0, z = 0.0) }
}

systems {
  # Stable 3D leapfrog (c·dt/dx = 0.14); a 2-cell sponge absorbs the boundary.
  wave { field = u; prev = um; velocity = 0.28; dt = 0.5; absorb = 0.08; absorb_width = 2 }
  update {
    on = probe
    dt = 0.5
    # a smooth Gaussian displacement pulse every 60 s (sums to 1), added to
    # both fields so the source has zero initial velocity
    let _ = fset(u, 7.0, 7.0, 7.0, fget(u, 7.0, 7.0, 7.0) + 0.025106 * periodic(60.0))
    let _ = fset(u, 7.0, 7.0, 8.0, fget(u, 7.0, 7.0, 8.0) + 0.035528 * periodic(60.0))
    let _ = fset(u, 7.0, 7.0, 9.0, fget(u, 7.0, 7.0, 9.0) + 0.025106 * periodic(60.0))
    let _ = fset(u, 7.0, 8.0, 7.0, fget(u, 7.0, 8.0, 7.0) + 0.035528 * periodic(60.0))
    let _ = fset(u, 7.0, 8.0, 8.0, fget(u, 7.0, 8.0, 8.0) + 0.050277 * periodic(60.0))
    let _ = fset(u, 7.0, 8.0, 9.0, fget(u, 7.0, 8.0, 9.0) + 0.035528 * periodic(60.0))
    let _ = fset(u, 7.0, 9.0, 7.0, fget(u, 7.0, 9.0, 7.0) + 0.025106 * periodic(60.0))
    let _ = fset(u, 7.0, 9.0, 8.0, fget(u, 7.0, 9.0, 8.0) + 0.035528 * periodic(60.0))
    let _ = fset(u, 7.0, 9.0, 9.0, fget(u, 7.0, 9.0, 9.0) + 0.025106 * periodic(60.0))
    let _ = fset(u, 8.0, 7.0, 7.0, fget(u, 8.0, 7.0, 7.0) + 0.035528 * periodic(60.0))
    let _ = fset(u, 8.0, 7.0, 8.0, fget(u, 8.0, 7.0, 8.0) + 0.050277 * periodic(60.0))
    let _ = fset(u, 8.0, 7.0, 9.0, fget(u, 8.0, 7.0, 9.0) + 0.035528 * periodic(60.0))
    let _ = fset(u, 8.0, 8.0, 7.0, fget(u, 8.0, 8.0, 7.0) + 0.050277 * periodic(60.0))
    let _ = fset(u, 8.0, 8.0, 8.0, fget(u, 8.0, 8.0, 8.0) + 0.071149 * periodic(60.0))
    let _ = fset(u, 8.0, 8.0, 9.0, fget(u, 8.0, 8.0, 9.0) + 0.050277 * periodic(60.0))
    let _ = fset(u, 8.0, 9.0, 7.0, fget(u, 8.0, 9.0, 7.0) + 0.035528 * periodic(60.0))
    let _ = fset(u, 8.0, 9.0, 8.0, fget(u, 8.0, 9.0, 8.0) + 0.050277 * periodic(60.0))
    let _ = fset(u, 8.0, 9.0, 9.0, fget(u, 8.0, 9.0, 9.0) + 0.035528 * periodic(60.0))
    let _ = fset(u, 9.0, 7.0, 7.0, fget(u, 9.0, 7.0, 7.0) + 0.025106 * periodic(60.0))
    let _ = fset(u, 9.0, 7.0, 8.0, fget(u, 9.0, 7.0, 8.0) + 0.035528 * periodic(60.0))
    let _ = fset(u, 9.0, 7.0, 9.0, fget(u, 9.0, 7.0, 9.0) + 0.025106 * periodic(60.0))
    let _ = fset(u, 9.0, 8.0, 7.0, fget(u, 9.0, 8.0, 7.0) + 0.035528 * periodic(60.0))
    let _ = fset(u, 9.0, 8.0, 8.0, fget(u, 9.0, 8.0, 8.0) + 0.050277 * periodic(60.0))
    let _ = fset(u, 9.0, 8.0, 9.0, fget(u, 9.0, 8.0, 9.0) + 0.035528 * periodic(60.0))
    let _ = fset(u, 9.0, 9.0, 7.0, fget(u, 9.0, 9.0, 7.0) + 0.025106 * periodic(60.0))
    let _ = fset(u, 9.0, 9.0, 8.0, fget(u, 9.0, 9.0, 8.0) + 0.035528 * periodic(60.0))
    let _ = fset(u, 9.0, 9.0, 9.0, fget(u, 9.0, 9.0, 9.0) + 0.025106 * periodic(60.0))
    let _ = fset(um, 7.0, 7.0, 7.0, fget(um, 7.0, 7.0, 7.0) + 0.025106 * periodic(60.0))
    let _ = fset(um, 7.0, 7.0, 8.0, fget(um, 7.0, 7.0, 8.0) + 0.035528 * periodic(60.0))
    let _ = fset(um, 7.0, 7.0, 9.0, fget(um, 7.0, 7.0, 9.0) + 0.025106 * periodic(60.0))
    let _ = fset(um, 7.0, 8.0, 7.0, fget(um, 7.0, 8.0, 7.0) + 0.035528 * periodic(60.0))
    let _ = fset(um, 7.0, 8.0, 8.0, fget(um, 7.0, 8.0, 8.0) + 0.050277 * periodic(60.0))
    let _ = fset(um, 7.0, 8.0, 9.0, fget(um, 7.0, 8.0, 9.0) + 0.035528 * periodic(60.0))
    let _ = fset(um, 7.0, 9.0, 7.0, fget(um, 7.0, 9.0, 7.0) + 0.025106 * periodic(60.0))
    let _ = fset(um, 7.0, 9.0, 8.0, fget(um, 7.0, 9.0, 8.0) + 0.035528 * periodic(60.0))
    let _ = fset(um, 7.0, 9.0, 9.0, fget(um, 7.0, 9.0, 9.0) + 0.025106 * periodic(60.0))
    let _ = fset(um, 8.0, 7.0, 7.0, fget(um, 8.0, 7.0, 7.0) + 0.035528 * periodic(60.0))
    let _ = fset(um, 8.0, 7.0, 8.0, fget(um, 8.0, 7.0, 8.0) + 0.050277 * periodic(60.0))
    let _ = fset(um, 8.0, 7.0, 9.0, fget(um, 8.0, 7.0, 9.0) + 0.035528 * periodic(60.0))
    let _ = fset(um, 8.0, 8.0, 7.0, fget(um, 8.0, 8.0, 7.0) + 0.050277 * periodic(60.0))
    let _ = fset(um, 8.0, 8.0, 8.0, fget(um, 8.0, 8.0, 8.0) + 0.071149 * periodic(60.0))
    let _ = fset(um, 8.0, 8.0, 9.0, fget(um, 8.0, 8.0, 9.0) + 0.050277 * periodic(60.0))
    let _ = fset(um, 8.0, 9.0, 7.0, fget(um, 8.0, 9.0, 7.0) + 0.035528 * periodic(60.0))
    let _ = fset(um, 8.0, 9.0, 8.0, fget(um, 8.0, 9.0, 8.0) + 0.050277 * periodic(60.0))
    let _ = fset(um, 8.0, 9.0, 9.0, fget(um, 8.0, 9.0, 9.0) + 0.035528 * periodic(60.0))
    let _ = fset(um, 9.0, 7.0, 7.0, fget(um, 9.0, 7.0, 7.0) + 0.025106 * periodic(60.0))
    let _ = fset(um, 9.0, 7.0, 8.0, fget(um, 9.0, 7.0, 8.0) + 0.035528 * periodic(60.0))
    let _ = fset(um, 9.0, 7.0, 9.0, fget(um, 9.0, 7.0, 9.0) + 0.025106 * periodic(60.0))
    let _ = fset(um, 9.0, 8.0, 7.0, fget(um, 9.0, 8.0, 7.0) + 0.035528 * periodic(60.0))
    let _ = fset(um, 9.0, 8.0, 8.0, fget(um, 9.0, 8.0, 8.0) + 0.050277 * periodic(60.0))
    let _ = fset(um, 9.0, 8.0, 9.0, fget(um, 9.0, 8.0, 9.0) + 0.035528 * periodic(60.0))
    let _ = fset(um, 9.0, 9.0, 7.0, fget(um, 9.0, 9.0, 7.0) + 0.025106 * periodic(60.0))
    let _ = fset(um, 9.0, 9.0, 8.0, fget(um, 9.0, 9.0, 8.0) + 0.035528 * periodic(60.0))
    let _ = fset(um, 9.0, 9.0, 9.0, fget(um, 9.0, 9.0, 9.0) + 0.025106 * periodic(60.0))
    x = (fget(u, 8.0, 8.0, 8.0) - x) / 0.5 + 0.0
    y = 0.0 + 0.0
    z = 0.0 + 0.0
  }
}
