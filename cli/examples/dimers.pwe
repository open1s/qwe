# dimers.pwe — force-driven association: atoms bond to their nearest neighbour.
#
# Each atom is integrated under a **Morse** potential, but the law is made
# **selective** with the coordination bindings: `pair { …; coord = rc }` exposes
# `rmin` (distance to the atom's nearest neighbour) and `n` (neighbours within
# `rc`). The law keeps the attraction only for the nearest partner
# (`if(r < rmin + …)`), so atoms pair up by proximity instead of all collapsing
# into one blob. Connectivity is detected from the geometry by the bond net.
#
# The law requires **mutual** nearest neighbours (`r <= rmin` for i AND
# `r <= rminj` for j), so pairing is symmetric — a clean set of A2 dimers.
#
#   pwe compile cli/examples/dimers.pwe -o dimers.pweb
#   pwe present dimers.pweb --port 8000
import "../../std/micro"

world {
  title = "Force-driven association (nearest-neighbour Morse)"
  gravity = (0, 0, 0)

  # Six atoms scattered in a box.
  entity a0 { state = (px = -1.8, py = 0.30, pz = -1.3, vx =  0.20, vy = 0.0, vz =  0.10, m = 1.0) shape = sphere; size = 0.22; color = 0x6EA8FF; tag = atom }
  entity a1 { state = (px =  1.9, py = 0.30, pz = -1.1, vx = -0.45, vy = 0.0, vz = -0.6, m = 1.0) shape = sphere; size = 0.22; color = 0x6EA8FF; tag = atom }
  entity a2 { state = (px =  0.6, py = 0.30, pz =  1.6, vx = -0.3, vy = 0.0, vz =  0.15, m = 1.0) shape = sphere; size = 0.22; color = 0x6EA8FF; tag = atom }
  entity a3 { state = (px = -1.4, py = 0.30, pz =  1.9, vx =  0.25, vy = 0.0, vz = -0.45, m = 1.0) shape = sphere; size = 0.22; color = 0x6EA8FF; tag = atom }
  entity a4 { state = (px =  2.3, py = 0.30, pz =  1.0, vx = -0.6, vy = 0.0, vz =  0.05, m = 1.0) shape = sphere; size = 0.22; color = 0x6EA8FF; tag = atom }
  entity a5 { state = (px = -0.4, py = 0.30, pz = -2.4, vx =  0.10, vy = 0.0, vz =  0.20, m = 1.0) shape = sphere; size = 0.22; color = 0x6EA8FF; tag = atom }

  bonds { tag = atom; within = 1.20 }
}

systems {
  # Selective Morse: full attraction only for the nearest neighbour (`rmin`),
  # reversed (repulsive) otherwise — bond to exactly one partner.
  pair  {
    tag = atom
    dt = 0.0006
    coord = 2.0
    law = micro.morse_force(0.60, 2.0, 0.90, r) * if(r <= rmin + 0.06 and r <= rminj + 0.06, 1.0, 0.0)
  }
  drift { tag = atom; dt = 0.0006; damp = 0.06 }
}
