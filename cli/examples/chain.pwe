# chain.pwe — a pendulum chain of distance joints (RFC-0039).
#
# Each link is a dynamic body; `joint { type = distance }` keeps the gap to its
# neighbour at the rest length. `gravity` + `integrate` drive the swing; the
# joint solver relaxes positions each step. The anchor is `dynamic = false`
# (infinite mass), so only the links move.

world {
  gravity = (0, -9.81, 0)
  title = "Pendulum chain"
  entity anchor { position = (0, 6, 0) mass = 1.0 dynamic = false color = 0x555566 size = 0.25 }
  entity b1 { position = (0, 5, 0) mass = 1.0 dynamic = true color = 0x66ccff size = 0.3 }
  entity b2 { position = (1, 4, 0) mass = 1.0 dynamic = true color = 0x66ccff size = 0.3 }
  entity b3 { position = (2, 3, 0) mass = 1.0 dynamic = true color = 0x66ccff size = 0.3 }
  entity bob { position = (3, 2, 0) mass = 4.0 dynamic = true color = 0xffaa33 size = 0.5 }
}

systems {
  gravity   { gravity_y = -9.81; dt = 0.016 }
  integrate { dt = 0.016 }
  joint { on = anchor; other = b1; type = distance; length = 1.0; iterations = 12 }
  joint { on = b1; other = b2; type = distance; length = 1.0; iterations = 12 }
  joint { on = b2; other = b3; type = distance; length = 1.0; iterations = 12 }
  joint { on = b3; other = bob; type = distance; length = 1.0; iterations = 12 }
}
