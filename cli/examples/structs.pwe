# structs.pwe — record (`struct`) types over flat state slots (RFC-0042).
#
# A `struct` names a group of fields; using it in `state = …` lays the fields
# out as dotted slots (`pos.x`, `pos.y`, …, `vel.x`, …). Fields are ordinary
# scalar slots, so this is zero-cost and fully deterministic. Access them as
# `pos.x` (own), `@shooter.pos.y` (another entity), in rules or `funcs`.
#
# For a state-only body the renderer takes the position from slots 0..2, so
# putting `pos` (a Vec3) first keeps the projectile at the right place.
#
#   cargo build --release -p pwe-cli
#   pwe compile cli/examples/structs.pwe -o structs.pweb
#   pwe run structs.pweb --steps 120

world {
  title = "struct record types (projectile)"
  gravity = (0, 0, 0)

  struct Vec3 { x = 0.0; y = 0.0; z = 0.0 }
  struct Particle { pos = Vec3; vel = Vec3; mass = 1.0 }

  entity shooter {
    state = (pos = Vec3, vel = (x = 4.0, y = 7.0, z = 0.0), mass = 1.0)  # inline record
    shape = sphere; size = 0.4; color = 0xE4572E
  }
  entity probe { state = (height = 0.0) }        # one scalar slot, tracks y
}

systems {
  update { on = shooter; dt = 0.02
    vel.y = vel.y + dt*(  (0.0 - 9.81) + 0.0 )  # v.y' = -g
    pos.x = pos.x + dt*(  vel.x )  # x'  = vx
    pos.y = pos.y + dt*(  vel.y )  # y'  = vy
  }
  update { on = probe; dt = 1.0
    height = @shooter.pos.y  # exact snap (dt=1) to the projectile's y
  }
}
