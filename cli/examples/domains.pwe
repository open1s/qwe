# domains.pwe — composes the standard library across physics domains.
# A temperature probe on a damped spring, cooling radiatively (all SI: Kelvin).
import "../../std/math"
import "../../std/forces"
import "../../std/thermal"
import "../../std/em"

world {
  gravity = (0, 0, 0)
  entity probe {
    state = (x = 1.0, vx = 0.0, temp = 353.15, potential = 0.0)
  }
}

systems {
  update {
    on = probe
    dt = 0.1
    # damped spring back to the origin
    vx = vx + inte(  forces.spring_accel(2.0, x, 1.0) + forces.damping_accel(0.3, vx, 1.0) )
    x = x + inte(  vx )                          # x' = vx
    temp = temp + inte(  thermal.radiative_cooling(temp, 293.15, 0.9, 1.0, 1.0, 700.0) )  # radiative cooling toward 20 °C (carbon: c=700)
    potential = potential + inte(  em.potential(6.0, x) )  # V = k·Q/r at distance x from a +6e carbon nucleus
  }
}
