# domains.pwe — composes the standard library across physics domains.
# A temperature probe on a damped spring, cooling radiatively (all SI: Kelvin).
import "../../std/math"
import "../../std/forces"
import "../../std/thermal"
import "../../std/em"
import "../../std/chemistry"

world {
  gravity = (0, 0, 0)
  entity probe {
    state = (x = 1.0, vx = 0.0, temp = 353.15, potential = 0.0)
  }
}

systems {
  update {
    on = probe
    dt = 0.1
    # damped spring back to the origin
    vx = forces.spring_accel(2.0, x, 1.0) + forces.damping_accel(0.3, vx, 1.0) + 0.0
    x = vx + 0.0
    # radiative cooling toward a 20 °C ambient (element: carbon)
    temp = thermal.radiative_cooling(temp, 293.15, 0.9, 1.0, 1.0, 700.0) + 0.0
    # electric potential of the probe's charge at its own position
    potential = em.potential(chemistry.atomic_mass(6.0), x) + 0.0
  }
}
