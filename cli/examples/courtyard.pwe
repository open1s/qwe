  entity wallN { position = (0, 0.6, 3.05); dynamic = false; box = (8.2, 1.2, 0.15); color = 0xA9663E; opacity = 0.35; label = false }
  entity wallS { position = (0, 0.6, -3.05); dynamic = false; box = (8.2, 1.2, 0.15); color = 0xA9663E; opacity = 0.35; label = false }
  entity wallE { position = (4.05, 0.6, 0); dynamic = false; box = (0.15, 1.2, 6.2); color = 0xA9663E; opacity = 0.35; label = false }
  entity wallW { position = (-4.05, 0.6, 0); dynamic = false; box = (0.15, 1.2, 6.2); color = 0xA9663E; opacity = 0.35; label = false }

  # --- people: 7 slots (x,y,z, vx,vz, dx,dz) ---
  entity p1 { state = (x = -2.4, y = 0.0, z = -1.4, vx = 0.8, vz = 0.6, dx = 0.8, dz = 0.6) shape = person; color = 0xE4572E }
  entity p1_lleg { state = (x = -2.4, y = 0.3, z = -1.4) shape = leg; color = 0xE4572E; label = false }
  entity p1_rleg { state = (x = -2.4, y = 0.3, z = -1.4) shape = leg; color = 0xE4572E; label = false }
  entity p1_larm { state = (x = -2.4, y = 0.78, z = -1.4) shape = arm; color = 0xE4572E; label = false }
  entity p1_rarm { state = (x = -2.4, y = 0.78, z = -1.4) shape = arm; color = 0xE4572E; label = false }
  entity p2 { state = (x = 0.6, y = 0.0, z = 1.6, vx = -0.6, vz = 0.8, dx = -0.6, dz = 0.8) shape = person; color = 0x2E86DE }
  entity p2_lleg { state = (x = 0.6, y = 0.3, z = 1.6) shape = leg; color = 0x2E86DE; label = false }
  entity p2_rleg { state = (x = 0.6, y = 0.3, z = 1.6) shape = leg; color = 0x2E86DE; label = false }
  entity p2_larm { state = (x = 0.6, y = 0.78, z = 1.6) shape = arm; color = 0x2E86DE; label = false }
  entity p2_rarm { state = (x = 0.6, y = 0.78, z = 1.6) shape = arm; color = 0x2E86DE; label = false }
  entity p3 { state = (x = 2.4, y = 0.0, z = -0.6, vx = -0.71, vz = -0.71, dx = -0.71, dz = -0.71) shape = person; color = 0x9B5DE5 }
  entity p3_lleg { state = (x = 2.4, y = 0.3, z = -0.6) shape = leg; color = 0x9B5DE5; label = false }
  entity p3_rleg { state = (x = 2.4, y = 0.3, z = -0.6) shape = leg; color = 0x9B5DE5; label = false }
  entity p3_larm { state = (x = 2.4, y = 0.78, z = -0.6) shape = arm; color = 0x9B5DE5; label = false }
  entity p3_rarm { state = (x = 2.4, y = 0.78, z = -0.6) shape = arm; color = 0x9B5DE5; label = false }
}

systems {
  # p1: smooth steering + terrain-following; gait phase = frac(t*0.55)
  update { on = p1; dt = 1.0
    let speed = 0.052
    let turn = 0.10
    let wander = random() < 0.03
    let ra = 2.0 * pi * random()
    let ndx = if(wander, cos(ra), dx)
    let ndz = if(wander, sin(ra), dz)
    let wx = if(x > 3.4 and ndx > 0.0, -ndx, if(x < -3.4 and ndx < 0.0, -ndx, ndx))
    let wz = if(z > 2.4 and ndz > 0.0, -ndz, if(z < -2.4 and ndz < 0.0, -ndz, ndz))
    let hx = vx + turn * (wx - vx)
    let hz = vz + turn * (wz - vz)
    let inv = 1.0 / sqrt(hx*hx + hz*hz + 0.000001)
    let nvx = hx * inv
    let nvz = hz * inv
    let path = 1.6 * sin(0.50 * x)
    let dd = z - path
    let channel = 1.0 / (1.0 + 3.0 * dd * dd)
    let hh = 0.30*sin(0.50*x)*cos(0.45*z) + 0.20*x - 0.15*channel
    let pn = t * 0.55
    let phase = pn - floor(pn)
    let bob = 0.02 * sin(4.0 * pi * phase)
    x = speed * nvx
    z = speed * nvz
    y = (hh + bob - y)
    vx = nvx - vx
    vz = nvz - vz
    dx = (wx - dx)
    dz = (wz - dz)
  }
  # p2: smooth steering + terrain-following; gait phase = frac(t*0.5)
  update { on = p2; dt = 1.0
    let speed = 0.048
    let turn = 0.10
    let wander = random() < 0.03
    let ra = 2.0 * pi * random()
    let ndx = if(wander, cos(ra), dx)
    let ndz = if(wander, sin(ra), dz)
    let wx = if(x > 3.4 and ndx > 0.0, -ndx, if(x < -3.4 and ndx < 0.0, -ndx, ndx))
    let wz = if(z > 2.4 and ndz > 0.0, -ndz, if(z < -2.4 and ndz < 0.0, -ndz, ndz))
    let hx = vx + turn * (wx - vx)
    let hz = vz + turn * (wz - vz)
    let inv = 1.0 / sqrt(hx*hx + hz*hz + 0.000001)
    let nvx = hx * inv
    let nvz = hz * inv
    let path = 1.6 * sin(0.50 * x)
    let dd = z - path
    let channel = 1.0 / (1.0 + 3.0 * dd * dd)
    let hh = 0.30*sin(0.50*x)*cos(0.45*z) + 0.20*x - 0.15*channel
    let pn = t * 0.5
    let phase = pn - floor(pn)
    let bob = 0.02 * sin(4.0 * pi * phase)
    x = speed * nvx
    z = speed * nvz
    y = (hh + bob - y)
    vx = nvx - vx
    vz = nvz - vz
    dx = (wx - dx)
    dz = (wz - dz)
  }
  # p3: smooth steering + terrain-following; gait phase = frac(t*0.6)
  update { on = p3; dt = 1.0
    let speed = 0.056
    let turn = 0.10
    let wander = random() < 0.03
    let ra = 2.0 * pi * random()
    let ndx = if(wander, cos(ra), dx)
    let ndz = if(wander, sin(ra), dz)
    let wx = if(x > 3.4 and ndx > 0.0, -ndx, if(x < -3.4 and ndx < 0.0, -ndx, ndx))
    let wz = if(z > 2.4 and ndz > 0.0, -ndz, if(z < -2.4 and ndz < 0.0, -ndz, ndz))
    let hx = vx + turn * (wx - vx)
    let hz = vz + turn * (wz - vz)
    let inv = 1.0 / sqrt(hx*hx + hz*hz + 0.000001)
    let nvx = hx * inv
    let nvz = hz * inv
    let path = 1.6 * sin(0.50 * x)
    let dd = z - path
    let channel = 1.0 / (1.0 + 3.0 * dd * dd)
    let hh = 0.30*sin(0.50*x)*cos(0.45*z) + 0.20*x - 0.15*channel
    let pn = t * 0.6
    let phase = pn - floor(pn)
    let bob = 0.02 * sin(4.0 * pi * phase)
    x = speed * nvx
    z = speed * nvz
    y = (hh + bob - y)
    vx = nvx - vx
    vz = nvz - vz
    dx = (wx - dx)
    dz = (wz - dz)
  }
  update { on = p1_lleg; dt = 1.0
    let hx = @p1.vx
    let hz = @p1.vz
    let pn = t * 0.55
    let ph = pn - floor(pn)
    let sw = 0.17 * sin(2.0*pi*ph + 0.000000)
    let tx = @p1.x + hx*sw + (-hz)*0.09
    let tz = @p1.z + hz*sw + hx*0.09
    let ty = @p1.y + 0.3
    x = (tx - x)
    z = (tz - z)
    y = (ty - y)
  }
  update { on = p1_rleg; dt = 1.0
    let hx = @p1.vx
    let hz = @p1.vz
    let pn = t * 0.55
    let ph = pn - floor(pn)
    let sw = 0.17 * sin(2.0*pi*ph + 3.141593)
    let tx = @p1.x + hx*sw + (-hz)*-0.09
    let tz = @p1.z + hz*sw + hx*-0.09
    let ty = @p1.y + 0.3
    x = (tx - x)
    z = (tz - z)
    y = (ty - y)
  }
  update { on = p1_larm; dt = 1.0
    let hx = @p1.vx
    let hz = @p1.vz
    let pn = t * 0.55
    let ph = pn - floor(pn)
    let sw = 0.11 * sin(2.0*pi*ph + 3.141593)
    let tx = @p1.x + hx*sw + (-hz)*0.17
    let tz = @p1.z + hz*sw + hx*0.17
    let ty = @p1.y + 0.78
    x = (tx - x)
    z = (tz - z)
    y = (ty - y)
  }
  update { on = p1_rarm; dt = 1.0
    let hx = @p1.vx
    let hz = @p1.vz
    let pn = t * 0.55
    let ph = pn - floor(pn)
    let sw = 0.11 * sin(2.0*pi*ph + 0.000000)
    let tx = @p1.x + hx*sw + (-hz)*-0.17
    let tz = @p1.z + hz*sw + hx*-0.17
    let ty = @p1.y + 0.78
    x = (tx - x)
    z = (tz - z)
    y = (ty - y)
  }
  update { on = p2_lleg; dt = 1.0
    let hx = @p2.vx
    let hz = @p2.vz
    let pn = t * 0.5
    let ph = pn - floor(pn)
    let sw = 0.17 * sin(2.0*pi*ph + 0.000000)
    let tx = @p2.x + hx*sw + (-hz)*0.09
    let tz = @p2.z + hz*sw + hx*0.09
    let ty = @p2.y + 0.3
    x = (tx - x)
    z = (tz - z)
    y = (ty - y)
  }
  update { on = p2_rleg; dt = 1.0
    let hx = @p2.vx
    let hz = @p2.vz
    let pn = t * 0.5
    let ph = pn - floor(pn)
    let sw = 0.17 * sin(2.0*pi*ph + 3.141593)
    let tx = @p2.x + hx*sw + (-hz)*-0.09
    let tz = @p2.z + hz*sw + hx*-0.09
    let ty = @p2.y + 0.3
    x = (tx - x)
    z = (tz - z)
    y = (ty - y)
  }
  update { on = p2_larm; dt = 1.0
    let hx = @p2.vx
    let hz = @p2.vz
    let pn = t * 0.5
    let ph = pn - floor(pn)
    let sw = 0.11 * sin(2.0*pi*ph + 3.141593)
    let tx = @p2.x + hx*sw + (-hz)*0.17
    let tz = @p2.z + hz*sw + hx*0.17
    let ty = @p2.y + 0.78
    x = (tx - x)
    z = (tz - z)
    y = (ty - y)
  }
  update { on = p2_rarm; dt = 1.0
    let hx = @p2.vx
    let hz = @p2.vz
    let pn = t * 0.5
    let ph = pn - floor(pn)
    let sw = 0.11 * sin(2.0*pi*ph + 0.000000)
    let tx = @p2.x + hx*sw + (-hz)*-0.17
    let tz = @p2.z + hz*sw + hx*-0.17
    let ty = @p2.y + 0.78
    x = (tx - x)
    z = (tz - z)
    y = (ty - y)
  }
  update { on = p3_lleg; dt = 1.0
    let hx = @p3.vx
    let hz = @p3.vz
    let pn = t * 0.6
    let ph = pn - floor(pn)
    let sw = 0.17 * sin(2.0*pi*ph + 0.000000)
    let tx = @p3.x + hx*sw + (-hz)*0.09
    let tz = @p3.z + hz*sw + hx*0.09
    let ty = @p3.y + 0.3
    x = (tx - x)
    z = (tz - z)
    y = (ty - y)
  }
  update { on = p3_rleg; dt = 1.0
    let hx = @p3.vx
    let hz = @p3.vz
    let pn = t * 0.6
    let ph = pn - floor(pn)
    let sw = 0.17 * sin(2.0*pi*ph + 3.141593)
    let tx = @p3.x + hx*sw + (-hz)*-0.09
    let tz = @p3.z + hz*sw + hx*-0.09
    let ty = @p3.y + 0.3
    x = (tx - x)
    z = (tz - z)
    y = (ty - y)
  }
  update { on = p3_larm; dt = 1.0
    let hx = @p3.vx
    let hz = @p3.vz
    let pn = t * 0.6
    let ph = pn - floor(pn)
    let sw = 0.11 * sin(2.0*pi*ph + 3.141593)
    let tx = @p3.x + hx*sw + (-hz)*0.17
    let tz = @p3.z + hz*sw + hx*0.17
    let ty = @p3.y + 0.78
    x = (tx - x)
    z = (tz - z)
    y = (ty - y)
  }
  update { on = p3_rarm; dt = 1.0
    let hx = @p3.vx
    let hz = @p3.vz
    let pn = t * 0.6
    let ph = pn - floor(pn)
    let sw = 0.11 * sin(2.0*pi*ph + 0.000000)
    let tx = @p3.x + hx*sw + (-hz)*-0.17
    let tz = @p3.z + hz*sw + hx*-0.17
    let ty = @p3.y + 0.78
    x = (tx - x)
    z = (tz - z)
    y = (ty - y)
  }
}
