# courtyard.pwe — people walking a smoothly sloped, winding courtyard.
#
# Ground:  y = h(x,z) = 0.30*sin(0.5x)*cos(0.45z) + 0.20x - 0.15*channel,
#   channel = 1/(1+3*(z-path)^2), path = 1.6*sin(0.5x). Gentle rolling
#   hills, a steady up-slope toward +x, and a lower winding path band
#   (sandy tiles). 14x11 tiles, each tilted to the local gradient via the
#   entity `rotation` field, so the ground slopes smoothly (not a staircase).
#
# People: a state-only body with seven slots (x,y,z, vx,vz = unit heading,
# dx,dz = desired heading). Slot 7 is the viewer Z-spin, so the gait phase
# is derived from the clock, phase = frac(t*gait). The rule steers the
# heading smoothly toward an occasionally-refreshed desired direction and
# away from the walls, advances by `speed`, and snaps y to the terrain. Four
# limb entities per person (legs with feet, arms with hands) read the owner
# via @name and swing along the heading from the same clock phase (legs
# opposite, arms counter-swinging). `random()` is seeded → identical replays.
#
#   cargo build --release -p pwe-cli
#   pwe compile cli/examples/courtyard.pwe -o courtyard.pweb
#   pwe run courtyard.pweb --port 8000        # live 3D viewer

world {
  title = "Courtyard walk (smooth slopes, winding path, walking people)"
  gravity = (0, 0, 0)

  # Shapes compose: `part <other-shape>` includes a named shape (with an
  # optional `at`/`scale`), so a person reuses the head/foot/hand shapes.
  shape head { part sphere = 0.115 at (0, 0, 0); }
  shape foot { part box    = (0.10, 0.05, 0.17) at (0, 0, 0.04); }
  shape hand { part sphere = 0.055 at (0, 0, 0); }
  shape person {
    part box  = (0.34, 0.46, 0.20) at (0, 0.57, 0);
    part head at (0, 0.92, 0);
  }
  shape leg {
    part capsule = (0.07, 0.34, 0.055) at (0, -0.12, 0);
    part foot at (0, -0.30, 0);
  }
  shape arm {
    part capsule = (0.05, 0.30, 0.045) at (0, -0.13, 0);
    part hand at (0, -0.31, 0);
  }

  # --- smoothly tilted terrain tiles ---
  entity t0x0 { position = (-3.575, -0.900, -2.750); rotation = (0.1637, 0.0, 0.1827); dynamic = false; box = (0.53, 0.12, 0.53); color = 0x63964B; label = false }
  entity t1x0 { position = (-3.025, -0.793, -2.750); rotation = (0.1691, 0.0, 0.2048); dynamic = false; box = (0.53, 0.12, 0.53); color = 0x65954B; label = false }
