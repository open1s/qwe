# courtyard.pwe — people walking a smoothly sloped courtyard, with
# simulation-driven orientation (they turn to face their heading and lean
# forward) and a seamless triangle-mesh ground (no tile stair-steps).
#
# Ground: a single `poly` triangle mesh sampled from
#   y = h(x,z) = 0.30*sin(0.5x)*cos(0.45z) + 0.20x - 0.15*channel,
#   channel = 1/(1+3*(z-path)^2), path = 1.6*sin(0.5x), plus a `path` mesh
#   (a sand-coloured strip) laid just above it. Because it is one mesh there
#   are no inter-tile seams.
#
# People: a state-only body with ten slots
#   (x,y,z, vx,vz = unit heading, dx,dz = desired heading, rx,ry,rz)
# with `orient = true`, so the viewer reads slots 7/8/9 as euler
# (pitch, yaw, roll): ry is the yaw about Y, rx a forward lean. The rule
# steers the heading smoothly toward an occasionally-refreshed desired
# direction and away from the walls, advances by `speed`, snaps y to the
# terrain, and sets yaw = atan2(vx, vz) + a small forward lean. Four limb
# entities (legs with feet, arms with hands, also `orient = true`) read the
# owner via @name and swing along the heading from the clock phase
# phase = frac(t*gait). `random()` is seeded, so replays are identical.
#
#   cargo build --release -p pwe-cli
#   pwe compile cli/examples/courtyard.pwe -o courtyard.pweb
#   pwe run courtyard.pweb --port 8000        # live 3D viewer

world {
  title = "Courtyard walk (mesh ground, turning/leaning people)"
  gravity = (0, 0, 0)

  shape head { part sphere = 0.115 at (0, 0, 0); }
  shape foot { part box    = (0.10, 0.05, 0.17) at (0, 0, 0.04); }
  shape hand { part sphere = 0.055 at (0, 0, 0); }
  shape person {
    part box  = (0.34, 0.46, 0.20) at (0, 0.57, 0);
    part head at (0, 0.92, 0);
  }
  shape leg {
    part capsule = (0.07, 0.34, 0.055) at (0, -0.12, 0);
    part foot at (0, -0.30, 0);
  }
  shape arm {
    part capsule = (0.05, 0.30, 0.045) at (0, -0.13, 0);
    part hand at (0, -0.31, 0);
  }
  shape terrain { part poly = [(-3.600,-0.864,-2.750),(-3.150,-0.778,-2.750),(-2.700,-0.684,-2.750),(-2.250,-0.583,-2.750),(-1.800,-0.476,-2.750),(-1.350,-0.366,-2.750),(-0.900,-0.254,-2.750),(-0.450,-0.140,-2.750),(0.000,-0.026,-2.750),(0.450,0.087,-2.750),(0.900,0.199,-2.750),(1.350,0.308,-2.750),(1.800,0.414,-2.750),(2.250,0.516,-2.750),(2.700,0.613,-2.750),(3.150,0.706,-2.750),(3.600,0.793,-2.750),(-3.600,-0.947,-2.292),(-3.150,-0.866,-2.292),(-2.700,-0.768,-2.292),(-2.250,-0.657,-2.292),(-1.800,-0.536,-2.292),(-1.350,-0.411,-2.292),(-0.900,-0.284,-2.292),(-0.450,-0.157,-2.292),(0.000,-0.029,-2.292),(0.450,0.098,-2.292),(0.900,0.222,-2.292),(1.350,0.342,-2.292),(1.800,0.457,-2.292),(2.250,0.566,-2.292),(2.700,0.667,-2.292),(3.150,0.761,-2.292),(3.600,0.847,-2.292),(-3.600,-1.060,-1.833),(-3.150,-0.983,-1.833),(-2.700,-0.881,-1.833),(-2.250,-0.757,-1.833),(-1.800,-0.614,-1.833),(-1.350,-0.466,-1.833),(-0.900,-0.319,-1.833),(-0.450,-0.175,-1.833),(0.000,-0.034,-1.833),(0.450,0.106,-1.833),(0.900,0.241,-1.833),(1.350,0.371,-1.833),(1.800,0.494,-1.833),(2.250,0.609,-1.833),(2.700,0.714,-1.833),(3.150,0.809,-1.833),(3.600,0.894,-1.833),(-3.600,-1.114,-1.375),(-3.150,-1.025,-1.375),(-2.700,-0.934,-1.375),(-2.250,-0.838,-1.375),(-1.800,-0.715,-1.375),(-1.350,-0.548,-1.375),(-0.900,-0.369,-1.375),(-0.450,-0.201,-1.375),(0.000,-0.042,-1.375),(0.450,0.110,-1.375),(0.900,0.255,-1.375),(1.350,0.394,-1.375),(1.800,0.525,-1.375),(2.250,0.644,-1.375),(2.700,0.753,-1.375),(3.150,0.849,-1.375),(3.600,0.932,-1.375),(-3.600,-1.075,-0.917),(-3.150,-0.987,-0.917),(-2.700,-0.895,-0.917),(-2.250,-0.800,-0.917),(-1.800,-0.707,-0.917),(-1.350,-0.609,-0.917),(-0.900,-0.450,-0.917),(-0.450,-0.249,-0.917),(0.000,-0.063,-0.917),(0.450,0.106,-0.917),(0.900,0.263,-0.917),(1.350,0.409,-0.917),(1.800,0.545,-0.917),(2.250,0.670,-0.917),(2.700,0.780,-0.917),(3.150,0.877,-0.917),(3.600,0.960,-0.917),(-3.600,-1.058,-0.458),(-3.150,-0.974,-0.458),(-2.700,-0.879,-0.458),(-2.250,-0.773,-0.458),(-1.800