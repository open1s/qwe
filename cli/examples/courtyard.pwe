  entity t0x4 { position = (-3.60, -1.686, 0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x63964B; label = false }
  entity t1x4 { position = (-2.80, -1.452, 0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x63964B; label = false }
  entity t2x4 { position = (-2.00, -1.138, 0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x66954B; label = false }
  entity t3x4 { position = (-1.20, -0.764, 0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x6F944C; label = false }
  entity t4x4 { position = (-0.40, -0.391, 0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x78924D; label = false }
  entity t5x4 { position = (0.40, -0.177, 0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xC9B27C; label = false }
  entity t6x4 { position = (1.20, 0.460, 0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x8E8F50; label = false }
  entity t7x4 { position = (2.00, 0.935, 0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x998D52; label = false }
  entity t8x4 { position = (2.80, 1.272, 0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xA28B53; label = false }
  entity t9x4 { position = (3.60, 1.504, 0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xA88A54; label = false }
  entity t0x5 { position = (-3.60, -1.618, 1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x63964B; label = false }
  entity t1x5 { position = (-2.80, -1.383, 1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x63964B; label = false }
  entity t2x5 { position = (-2.00, -1.076, 1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x67954B; label = false }
  entity t3x5 { position = (-1.20, -0.708, 1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x70934C; label = false }
  entity t4x5 { position = (-0.40, -0.306, 1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x7A924E; label = false }
  entity t5x5 { position = (0.40, 0.073, 1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x84904F; label = false }
  entity t6x5 { position = (1.20, 0.291, 1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xC9B27C; label = false }
  entity t7x5 { position = (2.00, 0.664, 1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xC9B27C; label = false }
  entity t8x5 { position = (2.80, 1.081, 1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x9D8C52; label = false }
  entity t9x5 { position = (3.60, 1.308, 1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xC9B27C; label = false }
  entity t0x6 { position = (-3.60, -1.502, 1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x63964B; label = false }
  entity t1x6 { position = (-2.80, -1.266, 1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x63964B; label = false }
  entity t2x6 { position = (-2.00, -0.974, 1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x6A944B; label = false }
  entity t3x6 { position = (-1.20, -0.635, 1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x72934D; label = false }
  entity t4x6 { position = (-0.40, -0.267, 1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x7B924E; label = false }
  entity t5x6 { position = (0.40, 0.106, 1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x85904F; label = false }
  entity t6x6 { position = (1.20, 0.445, 1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x8D8F50; label = false }
  entity t7x6 { position = (2.00, 0.702, 1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x948E51; label = false }
  entity t8x6 { position = (2.80, 0.898, 1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xC9B27C; label = false }
  entity t9x6 { position = (3.60, 1.143, 1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xC9B27C; label = false }
  entity t0x7 { position = (-3.60, -1.347, 2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x63964B; label = false }
  entity t1x7 { position = (-2.80, -1.110, 2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x66954B; label = false }
  entity t2x7 { position = (-2.00, -0.840, 2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x6D944C; label = false }
  entity t3x7 { position = (-1.20, -0.543, 2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x74934D; label = false }
  entity t4x7 { position = (-0.40, -0.229, 2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x7C914E; label = false }
  entity t5x7 { position = (0.40, 0.089, 2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x84904F; label = false }
  entity t6x7 { position = (1.20, 0.396, 2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x8C8F50; label = false }
  entity t7x7 { position = (2.00, 0.678, 2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x938E51; label = false }
  entity t8x7 { position = (2.80, 0.932, 2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x998D52; label = false }
  entity t9x7 { position = (3.60, 1.171, 2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x9F8C53; label = false }

  # --- low, semi-transparent courtyard wall (does not occlude the interior) ---
  entity wallN { position = (0, 0.6, 3.05); dynamic = false; box = (8.2, 1.2, 0.15); color = 0xA9663E; opacity = 0.35; label = false }
  entity wallS { position = (0, 0.6, -3.05); dynamic = false; box = (8.2, 1.2, 0.15); color = 0xA9663E; opacity = 0.35; label = false }
  entity wallE { position = (4.05, 0.6, 0); dynamic = false; box = (0.15, 1.2, 6.2); color = 0xA9663E; opacity = 0.35; label = false }
  entity wallW { position = (-4.05, 0.6, 0); dynamic = false; box = (0.15, 1.2, 6.2); color = 0xA9663E; opacity = 0.35; label = false }

  # --- people (x,y,z, vx,vz heading, dx,dz desired, phase) ---
  entity p1 { state = (x = -2.4, y = 0.0, z = -1.4, vx = 0.8, vz = 0.6, dx = 0.8, dz = 0.6, phase = 0.0) shape = person; color = 0xE4572E }
  entity p1_lleg { state = (x = -2.4, y = 0.2, z = -1.4) shape = leg; color = 0xE4572E; label = false }
  entity p1_rleg { state = (x = -2.4, y = 0.2, z = -1.4) shape = leg; color = 0xE4572E; label = false }
  entity p1_larm { state = (x = -2.4, y = 0.62, z = -1.4) shape = arm; color = 0xE4572E; label = false }
  entity p1_rarm { state = (x = -2.4, y = 0.62, z = -1.4) shape = arm; color = 0xE4572E; label = false }
  entity p2 { state = (x = 0.6, y = 0.0, z = 1.6, vx = -0.6, vz = 0.8, dx = -0.6, dz = 0.8, phase = 0.0) shape = person; color = 0x2E86DE }
  entity p2_lleg { state = (x = 0.6, y = 0.2, z = 1.6) shape = leg; color = 0x2E86DE; label = false }
  entity p2_rleg { state = (x = 0.6, y = 0.2, z = 1.6) shape = leg; color = 0x2E86DE; label = false }
  entity p2_larm { state = (x = 0.6, y = 0.62, z = 1.6) shape = arm; color = 0x2E86DE; label = false }
  entity p2_rarm { state = (x = 0.6, y = 0.62, z = 1.6) shape = arm; color = 0x2E86DE; label = false }
  entity p3 { state = (x = 2.4, y = 0.0, z = -0.6, vx = -0.71, vz = -0.71, dx = -0.71, dz = -0.71, phase = 0.0) shape = person; color = 0x9B5DE5 }
  entity p3_lleg { state = (x = 2.4, y = 0.2, z = -0.6) shape = leg; color = 0x9B5DE5; label = false }
  entity p3_rleg { state = (x = 2.4, y = 0.2, z = -0.6) shape = leg; color = 0x9B5DE5; label = false }
  entity p3_larm { state = (x = 2.4, y = 0.62, z = -0.6) shape = arm; color = 0x9B5DE5; label = false }
  entity p3_rarm { state = (x = 2.4, y = 0.62, z = -0.6) shape = arm; color = 0x9B5DE5; label = false }
}

systems {
  # p1: smooth steering + terrain-following + gait phase
  update { on = p1; dt = 1.0
    let speed = 0.052
    let turn = 0.10
    let wander = random() < 0.03
    let ra = 2.0 * pi * random()
    let ndx = if(wander, cos(ra), dx)
    let ndz = if(wander, sin(ra), dz)
    let wx = if(x > 3.4 and ndx > 0.0, -ndx, if(x < -3.4 and ndx < 0.0, -ndx, ndx))
    let wz = if(z > 2.4 and ndz > 0.0, -ndz, if(z < -2.4 and ndz < 0.0, -ndz, ndz))
    let hx = vx + turn * (wx - vx)
    let hz = vz + turn * (wz - vz)
    let inv = 1.0 / sqrt(hx*hx + hz*hz + 0.000001)
    let nvx = hx * inv
    let nvz = hz * inv
    let path = 1.6 * sin(0.50 * x)
    let dd = z - path
    let channel = 1.0 / (1.0 + 5.0 * dd * dd)
    let hh = 0.55*sin(0.50*x)*cos(0.45*z) + 0.30*x - 0.35*channel
    let bob = 0.02 * sin(4.0 * pi * phase)
    let pn = phase + 0.14
    let pw = if(pn >= 1.0, pn - 1.0, pn)
    x = speed * nvx
    z = speed * nvz
    y = (hh + bob - y)
    vx = nvx - vx
    vz = nvz - vz
    dx = (wx - dx)
    dz = (wz - dz)
    phase = (pw - phase)
  }
  # p2: smooth steering + terrain-following + gait phase
  update { on = p2; dt = 1.0
    let speed = 0.048
    let turn = 0.10
    let wander = random() < 0.03
    let ra = 2.0 * pi * random()
    let ndx = if(wander, cos(ra), dx)
    let ndz = if(wander, sin(ra), dz)
    let wx = if(x > 3.4 and ndx > 0.0, -ndx, if(x < -3.4 and ndx < 0.0, -ndx, ndx))
    let wz = if(z > 2.4 and ndz > 0.0, -ndz, if(z < -2.4 and ndz < 0.0, -ndz, ndz))
    let hx = vx + turn * (wx - vx)
    let hz = vz + turn * (wz - vz)
    let inv = 1.0 / sqrt(hx*hx + hz*hz + 0.000001)
    let nvx = hx * inv
    let nvz = hz * inv
    let path = 1.6 * sin(0.50 * x)
    let dd = z - path
    let channel = 1.0 / (1.0 + 5.0 * dd * dd)
    let hh = 0.55*sin(0.50*x)*cos(0.45*z) + 0.30*x - 0.35*channel
    let bob = 0.02 * sin(4.0 * pi * phase)
    let pn = phase + 0.13
    let pw = if(pn >= 1.0, pn - 1.0, pn)
    x = speed * nvx
    z = speed * nvz
    y = (hh + bob - y)
    vx = nvx - vx
    vz = nvz - vz
    dx = (wx - dx)
    dz = (wz - dz)
    phase = (pw - phase)
  }
  # p3: smooth steering + terrain-following + gait phase
  update { on = p3; dt = 1.0
    let speed = 0.056
    let turn = 0.10
    let wander = random() < 0.03
    let ra = 2.0 * pi * random()
    let ndx = if(wander, cos(ra), dx)
    let ndz = if(wander, sin(ra), dz)
    let wx = if(x > 3.4 and ndx > 0.0, -ndx, if(x < -3.4 and ndx < 0.0, -ndx, ndx))
    let wz = if(z > 2.4 and ndz > 0.0, -ndz, if(z < -2.4 and ndz < 0.0, -ndz, ndz))
    let hx = vx + turn * (wx - vx)
    let hz = vz + turn * (wz - vz)
    let inv = 1.0 / sqrt(hx*hx + hz*hz + 0.000001)
    let nvx = hx * inv
    let nvz = hz * inv
    let path = 1.6 * sin(0.50 * x)
    let dd = z - path
    let channel = 1.0 / (1.0 + 5.0 * dd * dd)
    let hh = 0.55*sin(0.50*x)*cos(0.45*z) + 0.30*x - 0.35*channel
    let bob = 0.02 * sin(4.0 * pi * phase)
    let pn = phase + 0.15
    let pw = if(pn >= 1.0, pn - 1.0, pn)
    x = speed * nvx
    z = speed * nvz
    y = (hh + bob - y)
    vx = nvx - vx
    vz = nvz - vz
    dx = (wx - dx)
    dz = (wz - dz)
    phase = (pw - phase)
  }
  update { on = p1_lleg; dt = 1.0
    let hx = @p1.vx
    let hz = @p1.vz
    let ph = @p1.phase
    let sw = 0.18 * sin(2.0*pi*ph + 0.000000)
    let tx = @p1.x + hx*sw + (-hz)*0.09
    let tz = @p1.z + hz*sw + hx*0.09
    let ty = @p1.y + 0.2
    x = (tx - x)
    z = (tz - z)
    y = (ty - y)
  }
  update { on = p1_rleg; dt = 1.0
    let hx = @p1.vx
    let hz = @p1.vz
    let ph = @p1.phase
    let sw = 0.18 * sin(2.0*pi*ph + 3.141593)
    let tx = @p1.x + hx*sw + (-hz)*-0.09
    let tz = @p1.z + hz*sw + hx*-0.09
    let ty = @p1.y + 0.2
    x = (tx - x)
    z = (tz - z)
    y = (ty - y)
  }
  update { on = p1_larm; dt = 1.0
    let hx = @p1.vx
    let hz = @p1.vz
    let ph = @p1.phase
    let sw = 0.12 * sin(2.0*pi*ph + 3.141593)
    let tx = @p1.x + hx*sw + (-hz)*0.16
    let tz = @p1.z + hz*sw + hx*0.16
    let ty = @p1.y + 0.62
    x = (tx - x)
    z = (tz - z)
    y = (ty - y)
  }
