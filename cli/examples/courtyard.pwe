  entity t7x2 { position = (2.00, 0.934, -1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x998D52; label = false }
  entity t8x2 { position = (2.80, 1.245, -1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xA18B53; label = false }
  entity t9x2 { position = (3.60, 1.479, -1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xA78B54; label = false }
  entity t0x3 { position = (-3.60, -1.712, -0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x63964B; label = false }
  entity t1x3 { position = (-2.80, -1.477, -0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x63964B; label = false }
  entity t2x3 { position = (-2.00, -1.177, -0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x65954B; label = false }
  entity t3x3 { position = (-1.20, -0.872, -0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x6C944C; label = false }
  entity t4x3 { position = (-0.40, -0.632, -0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xC9B27C; label = false }
  entity t5x3 { position = (0.40, 0.065, -0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x84904F; label = false }
  entity t6x3 { position = (1.20, 0.568, -0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x908E51; label = false }
  entity t7x3 { position = (2.00, 0.974, -0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x9A8D52; label = false }
  entity t8x3 { position = (2.80, 1.297, -0.38); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xA28B53; label = false }
