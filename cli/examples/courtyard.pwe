# courtyard.pwe — people walking a sloped, winding courtyard (DSL demo).
#
# Ground: a tiled heightfield.  h(x,z) = 0.55*sin(0.50x)*cos(0.45z) + 0.30x
#   - 0.35*channel,  channel = 1/(1+5*(z-path)^2),  path = 1.6*sin(0.50x)
# gives rolling hills, a clear up-slope toward +x (down toward -x), and a
# lowered winding "path" band (sandy tiles). The ground is 10x8 tiles whose
# height follows h, so the slope reads as steps.
#
# People: each is a state-only body (x,y,z = render position, vx,vz = unit
# heading, dx,dz = desired heading, phase = gait phase 0..1). The rule steers
# the heading smoothly toward an occasionally-refreshed desired direction and
# away from the walls, advances by `speed` along the heading, and snaps y to
# the terrain so the feet follow the slope. Four limb entities per person
# (two legs, two arms) read the owner via @name and swing along the heading
# from the owner gait phase: left/right legs are opposite and the arms
# counter-swing. `random()` is seeded, so every replay is identical.
#
#   cargo build --release -p pwe-cli
#   pwe compile cli/examples/courtyard.pwe -o courtyard.pweb
#   pwe run courtyard.pweb --port 8000        # live 3D viewer

world {
  title = "Courtyard walk (sloped terrain, winding path, walking people)"
  gravity = (0, 0, 0)

  shape person {
    part capsule = (0.15, 0.52, 0.12) at (0, 0.46, 0);
    part sphere  = 0.13 at (0, 0.90, 0);
  }
  shape leg { part capsule = (0.075, 0.46, 0.06) at (0, 0, 0); }
  shape arm { part capsule = (0.055, 0.40, 0.05) at (0, 0, 0); }

  # --- tiled terrain: height follows h; sandy where the path band is ---
  entity t0x0 { position = (-3.60, -1.396, -2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x63964B; label = false }
  entity t1x0 { position = (-2.80, -1.160, -2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x65954B; label = false }
  entity t2x0 { position = (-2.00, -0.874, -2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x6C944C; label = false }
  entity t3x0 { position = (-1.20, -0.560, -2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x74934D; label = false }
  entity t4x0 { position = (-0.40, -0.234, -2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x7C914E; label = false }
  entity t5x0 { position = (0.40, 0.094, -2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x84904F; label = false }
  entity t6x0 { position = (1.20, 0.412, -2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x8C8F50; label = false }
  entity t7x0 { position = (2.00, 0.711, -2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x948E51; label = false }
  entity t8x0 { position = (2.80, 0.982, -2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x9B8D52; label = false }
  entity t9x0 { position = (3.60, 1.219, -2.62); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xA08C53; label = false }
  entity t0x1 { position = (-3.60, -1.729, -1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xC9B27C; label = false }
  entity t1x1 { position = (-2.80, -1.502, -1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xC9B27C; label = false }
  entity t2x1 { position = (-2.00, -1.114, -1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x66954B; label = false }
  entity t3x1 { position = (-1.20, -0.688, -1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x71934C; label = false }
  entity t4x1 { position = (-0.40, -0.279, -1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x7B924E; label = false }
  entity t5x1 { position = (0.40, 0.119, -1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x85904F; label = false }
  entity t6x1 { position = (1.20, 0.498, -1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x8E8E50; label = false }
  entity t7x1 { position = (2.00, 0.841, -1.88); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x978D52; label = false }
