    let pn = t * 0.5
    let ph = pn - floor(pn)
    let sw = 0.11 * sin(2.0*pi*ph + 0.000000)
    let tx = @p2.x + hx*sw + (-hz)*-0.17
    let tz = @p2.z + hz*sw + hx*-0.17
    let ty = @p2.y + 0.78
    x = tx
    z = tz
    y = ty
    ry = @p2.ry
  }
  update { on = p3_lleg; dt = 1.0
    let hx = @p3.vx
    let hz = @p3.vz
    let pn = t * 0.6
    let ph = pn - floor(pn)
    let sw = 0.17 * sin(2.0*pi*ph + 0.000000)
    let tx = @p3.x + hx*sw + (-hz)*0.09
