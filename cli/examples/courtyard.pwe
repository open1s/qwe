  entity t2x2 { position = (-2.00, -1.346, -1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xC9B27C; label = false }
  entity t3x2 { position = (-1.20, -0.973, -1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0xC9B27C; label = false }
  entity t4x2 { position = (-0.40, -0.358, -1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x79924E; label = false }
  entity t5x2 { position = (0.40, 0.125, -1.12); dynamic = false; box = (0.80, 0.12, 0.75); color = 0x85904F; label = false }
