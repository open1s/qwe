  entity p3 { state = (x = 2.4, y = 0.0, z = -0.6, vx = -0.71, vz = -0.71, dx = -0.71, dz = -0.71, rx = 0.0, ry = 0.0, rz = 0.0) shape = person; orient = true; color = 0x9B5DE5 }
  entity p3_lleg { state = (x = 2.4, y = 0.3, z = -0.6, vx = -0.71, vz = -0.71, dx = -0.71, dz = -0.71, rx = 0.0, ry = 0.0, rz = 0.0) shape = leg; orient = true; vector = false; color = 0x9B5DE5; label = false }
  entity p3_rleg { state = (x = 2.4, y = 0.3, z = -0.6, vx = -0.71, vz = -0.71, dx = -0.71, dz = -0.71, rx = 0.0, ry = 0.0, rz = 0.0) shape = leg; orient = true; vector = false; color = 0x9B5DE5; label = false }
  entity p3_larm { state = (x = 2.4, y = 0.78, z = -0.6, vx = -0.71, vz = -0.71, dx = -0.71, dz = -0.71, rx = 0.0, ry = 0.0, rz = 0.0) shape = arm; orient = true; vector = false; color = 0x9B5DE5; label = false }
  entity p3_rarm { state = (x = 2.4, y = 0.78, z = -0.6, vx = -0.71, vz = -0.71, dx = -0.71, dz = -0.71, rx = 0.0, ry = 0.0, rz = 0.0) shape = arm; orient = true; vector = false; color = 0x9B5DE5; label = false }
}

systems {
  update { on = p1; dt = 1.0
    let speed = 0.052
    let turn = 0.10
    let wander = random() < 0.03
    let ra = 2.0 * pi * random()
    let ndx = if(wander, cos(ra), dx)
    let ndz = if(wander, sin(ra), dz)
    let wx = if(x > 3.4 and ndx > 0.0, -ndx, if(x < -3.4 and ndx < 0.0, -ndx, ndx))
    let wz = if(z > 2.4 and ndz > 0.0, -ndz, if(z < -2.4 and ndz < 0.0, -ndz, ndz))
    let hx = vx + turn * (wx - vx)
    let hz = vz + turn * (wz - vz)
    let inv = 1.0 / sqrt(hx*hx + hz*hz + 0.000001)
    let nvx = hx * inv
    let nvz = hz * inv
    let path = 1.6 * sin(0.50 * x)
    let dd = z - path
    let channel = 1.0 / (1.0 + 3.0 * dd * dd)
    let hh = 0.30*sin(0.50*x)*cos(0.45*z) + 0.20*x - 0.15*channel
    let pn = t * 0.55
    let phase = pn - floor(pn)
    let bob = 0.02 * sin(4.0 * pi * phase)
    let yaw = atan2(nvx, nvz)
    x = x + dt*(  speed * nvx )
    z = z + dt*(  speed * nvz )
    y = hh + bob
    vx = vx + dt*(  nvx - vx )
    vz = vz + dt*(  nvz - vz )
    dx = wx
    dz = wz
    ry = yaw
    rx = 0.12
  }
  update { on = p2; dt = 1.0
    let speed = 0.048
    let turn = 0.10
    let wander = random() < 0.03
    let ra = 2.0 * pi * random()
    let ndx = if(wander, cos(ra), dx)
    let ndz = if(wander, sin(ra), dz)
    let wx = if(x > 3.4 and ndx > 0.0, -ndx, if(x < -3.4 and ndx < 0.0, -ndx, ndx))
    let wz = if(z > 2.4 and ndz > 0.0, -ndz, if(z < -2.4 and ndz < 0.0, -ndz, ndz))
    let hx = vx + turn * (wx - vx)
    let hz = vz + turn * (wz - vz)
    let inv = 1.0 / sqrt(hx*hx + hz*hz + 0.000001)
    let nvx = hx * inv
    let nvz = hz * inv
    let path = 1.6 * sin(0.50 * x)
    let dd = z - path
    let channel = 1.0 / (1.0 + 3.0 * dd * dd)
    let hh = 0.30*sin(0.50*x)*cos(0.45*z) + 0.20*x - 0.15*channel
    let pn = t * 0.5
    let phase = pn - floor(pn)
    let bob = 0.02 * sin(4.0 * pi * phase)
    let yaw = atan2(nvx, nvz)
    x = x + dt*(  speed * nvx )
    z = z + dt*(  speed * nvz )
    y = hh + bob
    vx = vx + dt*(  nvx - vx )
    vz = vz + dt*(  nvz - vz )
    dx = wx
    dz = wz
    ry = yaw
    rx = 0.12
  }
  update { on = p3; dt = 1.0
    let speed = 0.056
    let turn = 0.10
    let wander = random() < 0.03
    let ra = 2.0 * pi * random()
    let ndx = if(wander, cos(ra), dx)
    let ndz = if(wander, sin(ra), dz)
    let wx = if(x > 3.4 and ndx > 0.0, -ndx, if(x < -3.4 and ndx < 0.0, -ndx, ndx))
    let wz = if(z > 2.4 and ndz > 0.0, -ndz, if(z < -2.4 and ndz < 0.0, -ndz, ndz))
    let hx = vx + turn * (wx - vx)
    let hz = vz + turn * (wz - vz)
    let inv = 1.0 / sqrt(hx*hx + hz*hz + 0.000001)
    let nvx = hx * inv
    let nvz = hz * inv
    let path = 1.6 * sin(0.50 * x)
    let dd = z - path
    let channel = 1.0 / (1.0 + 3.0 * dd * dd)
    let hh = 0.30*sin(0.50*x)*cos(0.45*z) + 0.20*x - 0.15*channel
    let pn = t * 0.6
    let phase = pn - floor(pn)
    let bob = 0.02 * sin(4.0 * pi * phase)
    let yaw = atan2(nvx, nvz)
    x = x + dt*(  speed * nvx )
    z = z + dt*(  speed * nvz )
    y = hh + bob
    vx = vx + dt*(  nvx - vx )
    vz = vz + dt*(  nvz - vz )
    dx = wx
    dz = wz
    ry = yaw
    rx = 0.12
  }
  update { on = p1_lleg; dt = 1.0
    let hx = @p1.vx
    let hz = @p1.vz
    let pn = t * 0.55
    let ph = pn - floor(pn)
    let sw = 0.17 * sin(2.0*pi*ph + 0.000000)
    let tx = @p1.x + hx*sw + (-hz)*0.09
    let tz = @p1.z + hz*sw + hx*0.09
    let ty = @p1.y + 0.3
    x = tx
    z = tz
    y = ty
    ry = @p1.ry
  }
  update { on = p1_rleg; dt = 1.0
    let hx = @p1.vx
    let hz = @p1.vz
    let pn = t * 0.55
    let ph = pn - floor(pn)
    let sw = 0.17 * sin(2.0*pi*ph + 3.141593)
    let tx = @p1.x + hx*sw + (-hz)*-0.09
    let tz = @p1.z + hz*sw + hx*-0.09
    let ty = @p1.y + 0.3
    x = tx
    z = tz
    y = ty
    ry = @p1.ry
  }
  update { on = p1_larm; dt = 1.0
    let hx = @p1.vx
    let hz = @p1.vz
    let pn = t * 0.55
    let ph = pn - floor(pn)
    let sw = 0.11 * sin(2.0*pi*ph + 3.141593)
    let tx = @p1.x + hx*sw + (-hz)*0.17
    let tz = @p1.z + hz*sw + hx*0.17
    let ty = @p1.y + 0.78
    x = tx
    z = tz
    y = ty
    ry = @p1.ry
  }
  update { on = p1_rarm; dt = 1.0
    let hx = @p1.vx
    let hz = @p1.vz
    let pn = t * 0.55
    let ph = pn - floor(pn)
    let sw = 0.11 * sin(2.0*pi*ph + 0.000000)
    let tx = @p1.x + hx*sw + (-hz)*-0.17
    let tz = @p1.z + hz*sw + hx*-0.17
    let ty = @p1.y + 0.78
    x = tx
    z = tz
    y = ty
    ry = @p1.ry
  }
  update { on = p2_lleg; dt = 1.0
    let hx = @p2.vx
