// The PWE language grammar (PEST). Rules are grouped by concern so the language
// stays easy to extend: add a rule here and a lowering arm in
// `LangParser`-consuming code (`parse`) / `build_systems` / `WorldModel::build_scene`.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" | ("#" ~ (!"\n" ~ ANY)*) | ("//" ~ (!"\n" ~ ANY)*) }
COMMENT = _{ "#" ~ (!"\n" ~ ANY)* | "//" ~ (!"\n" ~ ANY)* }

program = _{ SOI ~ world_section ~ funcs_section? ~ systems_section? ~ EOI }

// -- user-defined functions ---------------------------------------------------
// Pure functions over named params, called from `update` rules. The body is a
// scalar expression; params are referenced by slot `s0`, `s1`, … (param i is
// slot `s_i`). Lowered to EIR `CALL` functions.
funcs_section = { "funcs" ~ "{" ~ func_def* ~ "}" }
// The body is either a bare scalar expression (its return value) or a
// sequence of statements (lets and bounded loops) ending with an explicit
// `return expr`.
func_def = { ident ~ "(" ~ param_list? ~ ")" ~ "{" ~ func_body ~ "}" }
func_body = _{ func_stmts | expr }
func_stmts = { (func_item ~ ";"?)+ ~ func_return }
func_item = _{ let_stmt | repeat_stmt | for_stmt }
func_return = _{ return_kw ~ expr ~ ";"? }
param_list = { ident ~ ("," ~ ident)* }

// -- world model -------------------------------------------------------------
world_section = { "world" ~ "{" ~ world_item* ~ "}" }
world_item = _{ gravity_stmt | chan_stmt | struct_stmt | entity_stmt | pool_stmt | soft_stmt | field_stmt | params_stmt | title_stmt | shape_stmt }
gravity_stmt = { "gravity" ~ "=" ~ vec3 }
// A human-readable title for the run (shown by `pwe present`).
title_stmt = { "title" ~ "=" ~ string }
// `params { G = 1.0; k = 3.0 }` declares runtime-settable model parameters.
params_stmt = { "params" ~ "{" ~ (ident ~ "=" ~ value ~ unit_expr? ~ ";"?)* ~ "}" }
string = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
// A unit expression, e.g. `m`, `m/s^2`, `kg*m/s^2`, `1/s` (compile-time only).
// Units are bracketed (`1.0 [m/s^2]`), so they are lexically unambiguous next
// to identifiers and slot accesses like `s[0]`.
unit_expr = @{ "[" ~ unit_atom ~ (unit_op ~ unit_atom)* ~ "]" }
unit_atom = @{ unit_name ~ ("^" ~ unit_exp)? | ASCII_DIGIT+ }
unit_name = @{ "mol" | "kg" | "cd" | "K" | "A" | "s" | "m" }
unit_exp = @{ "-"? ~ ASCII_DIGIT+ }
unit_op = @{ "*" | "/" }
chan_stmt = { "chan" ~ ident ~ "{" ~ "value" ~ "=" ~ value ~ ";"? ~ "}" }
// `struct Name { field = <default>; field = <other-struct>; … }` — a named
// record flattened to dotted state slots (`pos.x`, `pos.y`, …).
struct_stmt = { "struct" ~ ident ~ "{" ~ struct_field* ~ "}" }
struct_field = { ident ~ "=" ~ (value | ident) ~ ";"? }
entity_stmt = { "entity" ~ ident ~ "{" ~ entity_field* ~ "}" }
// RFC-0038: `pool name[N] { <entity fields> }` — N initially-inactive slots.
pool_stmt = { "pool" ~ ident ~ "[" ~ number ~ "]" ~ "{" ~ entity_field* ~ "}" }
// RFC-0040: `soft name { nx = 8; ny = 8; spacing = 0.2; origin = (0,4,0); mass = 0.2 }`.
soft_stmt = { "soft" ~ ident ~ "{" ~ param* ~ "}" }
// A deterministic scalar grid field (PDE substrate): `field name { width = w; height = h; dx = d }`.
field_stmt = { "field" ~ ident ~ "{" ~ param* ~ "}" }

position_field = { "position" ~ "=" ~ vec3 ~ ";"? }
velocity_field = { "velocity" ~ "=" ~ vec3 ~ ";"? }
state_field = { "state" ~ "=" ~ (type_ref | vecN | named_state) ~ ";"? }
named_state = { "(" ~ state_item ~ ("," ~ state_item)* ~ ")" }
// `vec3 pos` declares N consecutive slots with a named vector element: `pos`
// reads the first component, `@self.state.pos.1` reads component 1.
state_item = { ("vec" ~ ASCII_DIGIT+ ~ ident) | (ident ~ "=" ~ state_rhs) | (value ~ unit_expr?) }
state_rhs = _{ named_state | type_ref | value ~ unit_expr? }
// A reference to a declared `struct` type used as a state layout.
type_ref = @{ ident }
mass_field = { "mass" ~ "=" ~ value ~ ";"? }
dynamic_field = { "dynamic" ~ "=" ~ boolean ~ ";"? }
nbody_field = { "nbody" ~ "=" ~ boolean ~ ";"? }
// `parent = <name>` marks a satellite (shown as a relative distance in `pwe present`).
parent_field = { "parent" ~ "=" ~ ident ~ ";"? }
restitution_field = { "restitution" ~ "=" ~ value ~ ";"? }
friction_field = { "friction" ~ "=" ~ value ~ ";"? }
box_field = { "box" ~ "=" ~ vec3 ~ ";"? }
// Static euler rotation (radians) for an entity, e.g. a tilted ground plane.
rotation_field = { "rotation" ~ "=" ~ vec3 ~ ";"? }
sphere_field = { "sphere" ~ "=" ~ value ~ ";"? }
hull_field = { "hull" ~ "=" ~ hull_list ~ ";"? }
camera_field = { "camera" ~ "=" ~ boolean ~ ";"? }
color_field = { "color" ~ "=" ~ color ~ ";"? }
color = @{ "0x" ~ ASCII_HEX_DIGIT+ }
// Presentation-only render hints (they do not affect simulation state).
shape_field = { "shape" ~ "=" ~ ident ~ ";"? }
// A user-defined custom shape: `shape <name> { part <kind> = <params> [at (x,y,z)]; }
shape_stmt = { "shape" ~ ident ~ "{" ~ shape_part* ~ "}" }
shape_part = _{ shape_builtin | shape_ref }
shape_builtin = { "part" ~ shape_kind ~ "=" ~ shape_part_value ~ shape_part_opt* ~ ";"? }
// `part <shape> [at (x,y,z)] [scale s];` includes another declared shape.
shape_ref = { "part" ~ ident ~ shape_part_opt* ~ ";"? }
shape_part_value = _{ string | hull_list | vec3 | value }
shape_part_opt = _{ at_opt | depth_opt | scale_opt | faces_opt }
faces_opt = { "faces" ~ "=" ~ faces_list }
faces_list = { "[" ~ face ~ ("," ~ face)* ~ "]" }
face = { "[" ~ ASCII_DIGIT+ ~ ("," ~ ASCII_DIGIT+)* ~ "]" }
at_opt = { "at" ~ vec3 }
depth_opt = { "depth" ~ value }
scale_opt = { "scale" ~ value }
shape_kind = @{ "point" | "sphere" | "box" | "capsule" | "svg" | "hull" | "poly" }
size_field = { "size" ~ "=" ~ (vec3 | value) ~ ";"? }
opacity_field = { "opacity" ~ "=" ~ value ~ ";"? }
// Orientation from state slots 7/8/9 (euler pitch, yaw, roll) for state bodies.
orient_field = { "orient" ~ "=" ~ boolean ~ ";"? }
// `vector = false` hides the viewer's velocity arrow / orbit ring.
vector_field = { "vector" ~ "=" ~ boolean ~ ";"? }
glow_field = { "glow" ~ "=" ~ value ~ ";"? }
label_field = { "label" ~ "=" ~ boolean ~ ";"? }
entity_field = _{ position_field | velocity_field | state_field | mass_field | dynamic_field
                 | nbody_field | parent_field | restitution_field | friction_field | box_field
                 | rotation_field
                 | sphere_field | hull_field | camera_field | color_field
                 | shape_field | size_field | opacity_field | glow_field | label_field
                 | orient_field | vector_field }

hull_list = { "[" ~ vec3 ~ ("," ~ vec3)* ~ "]" }
vec3 = { "(" ~ value ~ "," ~ value ~ "," ~ value ~ ")" }
vecN = { "(" ~ value ~ ("," ~ value)* ~ ")" }

// -- systems -----------------------------------------------------------------
systems_section = { "systems" ~ "{" ~ system* ~ "}" }
// Channel send/recv are first-class grammar productions; any other system kind
// is a generic `ident { param }` block.
system = _{ send_system | recv_system | generic_system }
send_system = { "send" ~ "{" ~ param* ~ "}" }
recv_system = { "recv" ~ "{" ~ param* ~ "}" }
generic_system = { ident ~ "{" ~ param* ~ "}" }
// A rule line: `let`/loops, an ODE rule (`deriv`/`integrate slot = rate` or
// `slot += rate`), an assignment rule (`slot = expr`), a bare call, or a
// system parameter (`ident = value|vecN|ident`).
param = { (let_stmt | repeat_stmt | for_stmt | ode_stmt | add_stmt
         | slot_lhs ~ "=" ~ expr | dot_lhs ~ "=" ~ expr | call
         | ident ~ "=" ~ (vecN | expr | ident) ~ unit_expr?) ~ ";"? }
// ODE rule: the RHS is the derivative/rate (integrated as slot += dt·rate).
ode_kw = @{ ("deriv" | "integrate") ~ !(ASCII_ALPHANUMERIC | "_") }
ode_stmt = { ode_kw ~ (dot_lhs | slot_lhs | ident) ~ "=" ~ expr }
// Sugar for an ODE rule: `slot += rate`.
add_stmt = { (dot_lhs | slot_lhs | ident) ~ "+=" ~ expr }
// Dynamic slot LHS: `s[i] = expr` writes the State slot at a runtime index.
slot_lhs = { "s" ~ "[" ~ expr ~ "]" }
// Dotted rule LHS for struct fields: `pos.x = expr`.
dot_lhs = { ident ~ ("." ~ (ident | ASCII_DIGIT+))+ }
// `let name = expr` binds a reusable local in an `update` rule.
let_stmt = { "let" ~ ident ~ "=" ~ expr }
// `repeat n { let … }` unrolls at lowering time (bounded) with per-loop
// break/continue gating, enabling fixed-point / Newton-style iteration within
// one step. Optional `until (cond)` exits after an iteration when cond is
// true; `while (cond)` skips an iteration when cond is false. Bodies may
// contain only `let`, nested loops, and `break`/`continue` (`break if (cond)`);
// slot rules stay outside the loop.
repeat_stmt = { "repeat" ~ number ~ repeat_gate? ~ "{" ~ repeat_item* ~ "}" }
repeat_gate = { gate_kw ~ "(" ~ expr ~ ")" }
gate_kw = @{ "until" ~ !(ASCII_ALPHANUMERIC | "_") | "while" ~ !(ASCII_ALPHANUMERIC | "_") }
// `for i in lo..hi { let … }` unrolls with the index bound as a local per
// iteration (ascending integers, bounded). Same body restrictions as repeat.
for_stmt = { "for" ~ ident ~ "in" ~ for_range ~ "{" ~ repeat_item* ~ "}" }
for_range = { number ~ ".." ~ number }
repeat_item = { (let_stmt | repeat_stmt | for_stmt | break_stmt | continue_stmt) ~ ";"? }
// `break` / `continue` (optionally `break if (cond)`) inside a loop body.
break_stmt = { break_kw ~ (if_kw ~ expr)? }
continue_stmt = { continue_kw ~ (if_kw ~ expr)? }
break_kw = @{ "break" ~ !(ASCII_ALPHANUMERIC | "_") }
continue_kw = @{ "continue" ~ !(ASCII_ALPHANUMERIC | "_") }
if_kw = @{ "if" ~ !(ASCII_ALPHANUMERIC | "_") }

// A general scalar expression over state slots (`s0`, `s1`, …), constants,
// the operators + - * / with parentheses, comparisons (< > <= >= == !=),
// logical connectives (`and`/`or`/`not`, also `&&`/`||`/`!`), and function
// calls (sin cos exp ln sqrt pow, min max if). Comparisons and logical ops
// yield 1.0 / 0.0; any nonzero operand counts as true. Precedence:
// `not` > `and` > `or` > comparison > additive. `not` binds to the following
// factor: write `not (x > 0)` for a negated comparison.
expr = { logical_or }
logical_or = { logical_and ~ (or_op ~ logical_and)* }
or_op = @{ "or" ~ !(ASCII_ALPHANUMERIC | "_") | "||" }
logical_and = { comparison ~ (and_op ~ comparison)* }
and_op = @{ "and" ~ !(ASCII_ALPHANUMERIC | "_") | "&&" }
comparison = { additive ~ (cmp_op ~ additive)* }
cmp_op = { "<=" | ">=" | "==" | "!=" | "<" | ">" }
additive = { term ~ (add_op ~ term)* }
add_op = { "+" | "-" }
term = { factor ~ (term_op ~ factor)* }
term_op = { "*" | "/" | "%" }
factor = { unary | number | call | "(" ~ expr ~ ")" | slot | slot_dyn | entity_ref | time | constant | namespaced | state_name }
// Dynamic slot read: `s[i]` reads the State slot at a runtime index.
slot_dyn = { "s" ~ "[" ~ expr ~ "]" }
unary = { "-" ~ factor | not_op ~ factor }
not_op = @{ "not" ~ !(ASCII_ALPHANUMERIC | "_") | "!" }
call = { func_name ~ "(" ~ expr? ~ ("," ~ expr)* ~ ")" }
// Any identifier may be called; builtins (sin cos exp ln sqrt pow min max if
// random emit) are special-cased in lowering, everything else resolves to a
// user-defined function from the `funcs` section.
func_name = @{ ident ~ ("." ~ ident)* }
slot = @{ "s" ~ ASCII_DIGIT+ ~ !(ASCII_ALPHANUMERIC | "_") }
entity_ref = { "@" ~ ident ~ "." ~ ( slot | prop_path ) }
prop_path = { ident ~ ("." ~ (ident | ASCII_DIGIT+))* }
state_name = @{ ident }
// A namespaced member reference (`module::param`).
namespaced = @{ ident ~ "." ~ ident ~ ("." ~ ident)* }
time = @{ "t" ~ !(ASCII_ALPHANUMERIC | "_") }
constant = @{ ("pi" | "e") ~ !(ASCII_ALPHANUMERIC | "_") }

// -- atoms -------------------------------------------------------------------
ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
number = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+ | "." ~ !".")? ~ (("e" | "E") ~ "-"? ~ ASCII_DIGIT+)? }
value = { number ~ ("/" ~ number)? }
boolean = { "true" | "false" }
return_kw = @{ "return" ~ !(ASCII_ALPHANUMERIC | "_") }